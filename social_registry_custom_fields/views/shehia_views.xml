<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_g2p_shehia_tree" model="ir.ui.view">
        <field name="name">g2p.shehia.tree</field>
        <field name="model">g2p.shehia</field>
        <field name="arch" type="xml">
            <tree string="Shehias" editable="bottom">
                <field name="name"/>
                <field name="district_id"/>
                <field name="region_id"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_g2p_shehia_form" model="ir.ui.view">
        <field name="name">g2p.shehia.form</field>
        <field name="model">g2p.shehia</field>
        <field name="arch" type="xml">
            <form string="Shehia">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="district_id"/>
                            <field name="region_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_g2p_shehia_search" model="ir.ui.view">
        <field name="name">g2p.shehia.search</field>
        <field name="model">g2p.shehia</field>
        <field name="arch" type="xml">
            <search string="Search Shehias">
                <field name="name"/>
                <field name="district_id"/>
                <field name="region_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="District" name="group_by_district" domain="[]" context="{'group_by': 'district_id'}"/>
                    <filter string="Region" name="group_by_region" domain="[]" context="{'group_by': 'region_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_g2p_shehia" model="ir.actions.act_window">
        <field name="name">Shehia</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">g2p.shehia</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_g2p_shehia_search"/>
        <field name="context">{'search_default_group_by_district': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Shehia!
            </p>
            <p>
                Click create to maintain Shehia master data.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_g2p_shehia"
        name="Shehia"
        action="action_g2p_shehia"
        parent="g2p_registry_base.g2p_configuration_menu_root"
        sequence="44"
        groups="g2p_registry_base.group_g2p_admin,g2p_registry_base.group_g2p_registrar"
    />
</odoo>
